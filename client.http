### IAM API Testing (v1)

###
# @name Health Check
GET http://localhost:8080/health

###
# @name Login
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin"
}

> {% client.global.set("auth_token", response.body.data.token); %}

###
# @name Get Current User
GET http://localhost:8080/api/v1/auth/me
Authorization: Bearer {{auth_token}}

###
# @name List Users
GET http://localhost:8080/api/v1/user?page=1&size=20
Authorization: Bearer {{auth_token}}

###
# @name Focus User (admin)
GET http://localhost:8080/api/v1/user/1
Authorization: Bearer {{auth_token}}

###
# @name Command: Reset Password
POST http://localhost:8080/api/v1/user/1/commands
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "action": "reset_password",
  "params": {
    "new_password": "new_admin_password"
  }
}

###
# @name Command: Assign Role
POST http://localhost:8080/api/v1/user/1/commands
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "action": "assign_role",
  "params": {
    "role_id": 1
  }
}

###
# @name Command: Create User (admin only)
POST http://localhost:8080/api/v1/user/1/commands
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "action": "create_user",
  "params": {
    "username": "newuser",
    "password": "password123",
    "role_ids": [1]
  }
}

###
# @name Command: Disable User
POST http://localhost:8080/api/v1/user/2/commands
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "action": "disable",
  "params": {}
}

###
# @name List Roles
GET http://localhost:8080/api/v1/role?page=1&size=20
Authorization: Bearer {{auth_token}}

###
# @name Focus Role (admin)
GET http://localhost:8080/api/v1/role/1
Authorization: Bearer {{auth_token}}

###
# @name Command: Add Permission to Role
POST http://localhost:8080/api/v1/role/1/commands
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "action": "add_permission",
  "params": {
    "permission_id": 1
  }
}

###
# @name Command: Remove Permission from Role
POST http://localhost:8080/api/v1/role/1/commands
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "action": "remove_permission",
  "params": {
    "permission_id": 1
  }
}

###
# @name Command: Clone Role
POST http://localhost:8080/api/v1/role/1/commands
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "action": "clone",
  "params": {
    "new_name": "管理员副本"
  }
}

###
# @name List Permissions
GET http://localhost:8080/api/v1/permission?page=1&size=20
Authorization: Bearer {{auth_token}}

###
# @name Focus Permission
GET http://localhost:8080/api/v1/permission/1
Authorization: Bearer {{auth_token}}

###
# @name Permission Command (Not Supported)
POST http://localhost:8080/api/v1/permission/1/commands
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "action": "test",
  "params": {}
}

###
# @name Permission: Create Permission
POST http://localhost:8080/api/v1/permission/1/commands
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "action": "create_permission",
  "params": {
    "name": "删除文章",
    "code": "article:delete",
    "resource": "article",
    "action": "delete",
    "description": "允许删除文章"
  }
}

###
# @name External: Register Permission
POST http://localhost:8080/api/v1/system/permissions
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "name": "编辑文章",
  "code": "article:update",
  "resource": "article",
  "action": "update",
  "description": "允许编辑文章"
}

###
# @name External: Check Permission (by Token)
GET http://localhost:8080/api/v1/system/check-permission?permission_code=user:create
Authorization: Bearer {{auth_token}}

###
# @name External: Check Permission (by User ID)
GET http://localhost:8080/api/v1/system/check-permission?user_id=2&permission_code=user:create
Authorization: Bearer {{auth_token}}

###
# @name External: Validate Identity + Permission
POST http://localhost:8080/api/v1/system/validate
Content-Type: application/json

{
  "token": "{{auth_token}}",
  "required_permissions": ["user:create", "user:read"]
}

###
# @name Reload Formats
POST http://localhost:8080/api/v1/system/reload-formats
Authorization: Bearer {{auth_token}}
